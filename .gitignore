# Dependencies
node_modules/

# Build output
dist/
release/
target/

# Generated by wasm-pack. Only the files below are tracked. wasm-pack also
# writes its own `.gitignore` containing `*` into this folder; that second
# file would override the exceptions here, so `npm run build:wasm` deletes it
# (scripts/clean-wasm-pkg.mjs).
src/wasm/pkg/*
!src/wasm/pkg/.gitkeep
!src/wasm/pkg/README.md
!src/wasm/pkg/narrately_core.d.ts

# Model files are downloaded or synced, never committed. Keep the pin.
models/onnx-community/Kokoro-82M-ONNX/*
!models/onnx-community/Kokoro-82M-ONNX/README.md
!models/onnx-community/Kokoro-82M-ONNX/REVISION.txt

# Test and tooling output
smoke-test-output.wav
*.tsbuildinfo
coverage/
web-ext-artifacts/

# Logs
*.log
npm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example

# Editors and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
